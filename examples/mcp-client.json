{
  "mcpServers": {
    "local-knowledge-memory": {
      "command": "/absolute/path/to/MCP-Server/.venv/bin/python",
      "args": ["-m", "copilot.mcp_server"],
      "env": {
        "COPILOT_DATA_DIR": "/absolute/path/to/MCP-Server/.local-copilot",
        "COPILOT_OLLAMA_URL": "http://127.0.0.1:11434",
        "OLLAMA_NO_CLOUD": "1"
      }
    }
  }
}
